# =============================================================================
# LLM Form Modeler 环境配置示例(复制为 .env 后按需修改)
# 后端启动时按 项目根/.env → backend/.env 顺序查找加载(见 src/main.py)。
# =============================================================================

# ── LLM 配置(OpenAI 兼容接口)────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60
# 模型上下文窗口(token)——对话压缩的触发基准(默认 200000)。
# 不同模型窗口不同,换小窗口模型时务必同步调整,否则压缩触发线失真。
# LLM_CONTEXT_WINDOW=200000
# 完整 prompt/响应入库(管理端全链路追溯)。默认开;关闭后退回摘要模式
# (仅消息条数/字符量,响应截断 500 字)。图片始终以占位符记录(防多 MB base64)。
# LLM_LOG_FULL=1

# ── 上游服务(njmind-modeler)─────────────────────────────────
# 上游地址不经 env 配置:由宿主 services 表按请求下发(见 resolve_base),
# 未下发的服务调用时 fail-closed 报错。此处仅保留 HTTP 行为参数。
# UPSTREAM_TIMEOUT=30
# UPSTREAM_CACHE_TTL=300  # 默认 300(5分钟);设 0 可禁用缓存

# ── 插件(pack)──────────────────────────────────────────────
# 启动时的加载白名单(逗号分隔 pack 名);不设 = 加载全部。
# 注意:管理端(/ai-modeler/admin.html)切换插件开关后会生成 PACK_STATE_PATH
# 状态文件,此后以状态文件为准(重启也保持),本变量退化为首次初始化默认值。
PACKS_ENABLED=
# 插件启停状态文件(管理端写入;默认与 conversations.db 同目录,随部署卷持久化)
PACK_STATE_PATH=data/pack_state.json
# 插件依赖检测的连通性探针(启动/装配期):1=开(默认,2~3s 超时),
# 0=只做配置存在性检查(离线/CI 环境)。
# PACK_DEPENDENCY_PROBE=1
# PACK_DEPENDENCY_PROBE_TIMEOUT=3

# ── 通用后台任务框架(任务中心)──────────────────────────────
# 任务线程池并发数(默认 2);同 queue_key 的任务(如同库导入)始终串行。
# TASK_WORKERS=2

# ── 知识图谱插件(knowledge_graph pack)─────────────────────
# 依赖声明见 backend/src/domains/knowledge_graph/config.yaml;
# 未配置以下变量时插件中心显示"依赖未配置"且不可启用(fail-closed),
# 也可部署后在 管理端→插件→设置 里补配(优先级:设置页 > env)。
# 本地 docker 快速起 Neo4j:
#   docker run -d --name kg-neo4j -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/<你的密码> neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Milvus 2.4/2.5 服务端(每知识库一个独立 collection,物理隔离)
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
# 向量化模型(OpenAI 兼容 /v1/embeddings;不配 = 纯图谱检索,导入不受影响)。
# dashscope 示例:text-embedding-v3
LLM_EMBED_MODEL=
# 上传原始文件落盘目录(默认 data/kg/files)
# KG_FILES_DIR=data/kg/files
# 其余抽取/批次/检索参数(块大小/批内并行/熔断阈值/词表等)在
# 管理端→插件→knowledge_graph→设置 里调整(全部热生效)。

# ── 管理端(可选口令)───────────────────────────────────────
# 管理页 /ai-modeler/admin.html 的访问模式:
#   未配置(默认)→ 开放访问,无口令直接用(内网/网关后部署的取舍;
#                 启动日志会打醒目警告)
#   配置口令     → 所有 /api/admin/* 需带 X-Admin-Token 头(可选加固)
# 注意:开放模式下,凡能访问本服务的客户端都可查看全部会话(含完整
# prompt)/删除会话/切换插件——公网或不可信网络必须配置。
ADMIN_TOKEN=

# ── 存储 ───────────────────────────────────────────────────
DATABASE_PATH=data/conversations.db

# ── CORS(嵌入模式)─────────────────────────────────────────
# 允许跨域访问本服务的宿主来源(逗号分隔);不设 = 允许所有(仅开发期)。
# 生产建议配置宿主域名,防止任意网页直调本服务。
CORS_ALLOWED_ORIGINS=

# ── 请求头透传(嵌入模式 SSO)───────────────────────────────
# 需要透传给上游的请求头前缀(逗号分隔);默认含 x-/authorization/cookie/
# tenant/enterprise/accept-language。
# FORWARD_HEADER_PREFIXES=

# ── 日志 ───────────────────────────────────────────────────
# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_FILE_MAX_BYTES=52428800  # 默认 52428800(50MB)
# LOG_RETENTION=5  # 默认保留 5 份
