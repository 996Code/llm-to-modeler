# =============================================================================
# LLM Form Modeler 环境配置示例(复制为 .env 后按需修改)
#
# 一份 .env 同时服务三方:
#   1) 后端启动加载(项目根/.env → backend/.env 顺序,见 src/main.py)
#   2) docker compose 变量替换(${HOST_PORT} / ${APP_MEM_LIMIT} / ${NEO4J_PASSWORD} 等)
#   3) compose env_file 注入容器(容器内变量与 1) 等效)
# Docker 部署:cp .env.example .env 填好必填项 → ./deploy.sh
# =============================================================================

# ── LLM 配置(必填;OpenAI 兼容接口,dashscope/oneapi/vllm 均可)──
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60
# 模型上下文窗口(token)——对话压缩的触发基准(默认 200000)。
# 不同模型窗口不同,换小窗口模型时务必同步调整,否则压缩触发线失真。
# LLM_CONTEXT_WINDOW=200000
# 完整 prompt/响应入库(管理端全链路追溯)。默认开;关闭后退回摘要模式
# (仅消息条数/字符量,响应截断 500 字)。图片始终以占位符记录(防多 MB base64)。
# LLM_LOG_FULL=1
# 限速(可选;撞服务商限额时配,0=不限)
# LLM_RPM_LIMIT=0
# LLM_TPM_LIMIT=0

# ── 向量化(知识图谱插件的向量检索;默认本地 bge-m3,零 API 费用)──
# local(默认):进程内 ONNX bge-m3,首次部署由 deploy.sh 自动下载到
#   data/models/embedding/(~543MB,跨版本复用),无需填 LLM_EMBED_MODEL
# api:填云端模型名(如 dashscope text-embedding-v3)
EMBEDDING_BACKEND=local
LLM_EMBED_MODEL=

# ── 上游服务(njmind-modeler)─────────────────────────────────
# 上游地址不经 env 配置:由宿主 services 表按请求下发(见 resolve_base),
# 未下发的服务调用时 fail-closed 报错。此处仅保留 HTTP 行为参数。
# UPSTREAM_TIMEOUT=30
# UPSTREAM_CACHE_TTL=300  # 默认 300(5分钟);设 0 可禁用缓存

# ── 插件(pack)──────────────────────────────────────────────
# 启动时的加载白名单(逗号分隔 pack 名);不设 = 加载全部。
# 注意:管理端(/ai-modeler/admin.html)切换插件开关后会生成 PACK_STATE_PATH
# 状态文件,此后以状态文件为准(重启也保持),本变量退化为首次初始化默认值。
PACKS_ENABLED=
# 插件启停状态文件(管理端写入;默认 data/ 目录,随部署卷持久化)
PACK_STATE_PATH=data/pack_state.json
# 插件依赖检测的连通性探针(启动/装配期):1=开(默认,2~3s 超时),
# 0=只做配置存在性检查(离线/CI 环境)。
# PACK_DEPENDENCY_PROBE=1
# PACK_DEPENDENCY_PROBE_TIMEOUT=3

# ── 通用后台任务框架(任务中心)──────────────────────────────
# 任务线程池并发数(默认 2);同 queue_key 的任务(如同库导入)始终串行。
# TASK_WORKERS=2

# ── 知识图谱插件(knowledge_graph pack)─────────────────────
# 依赖声明见 backend/src/domains/knowledge_graph/config.yaml;
# 未配置以下变量时插件中心显示"依赖未配置"且不可启用(fail-closed),
# 也可部署后在 管理端→插件→设置 里补配(优先级:设置页 > env)。
# compose 部署时 Neo4j/Milvus 在容器内网自动组网,只需设密码(下方部署段);
# 本地裸机开发快起 Neo4j:
#   docker run -d --name kg-neo4j -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/<你的密码> neo4j:5-community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Milvus 2.4/2.5 服务端(每知识库一个独立 collection,物理隔离)
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
# 上传原始文件落盘目录(默认 data/kg/files)
# KG_FILES_DIR=data/kg/files
# 其余抽取/批次/检索参数(块大小/批内并行/熔断阈值/词表等)在
# 管理端→插件→knowledge_graph→设置 里调整(全部热生效)。

# ── 管理端(可选口令)───────────────────────────────────────
# 管理页 /ai-modeler/admin.html 的访问模式:
#   未配置(默认)→ 开放访问,无口令直接用(内网/网关后部署的取舍;
#                 启动日志会打醒目警告)
#   配置口令     → 所有 /api/admin/* 需带 X-Admin-Token 头(可选加固);
#                 同时作为 auth.html 门禁页的访问密钥(AuthMiddleware)
# 注意:开放模式下,凡能访问本服务的客户端都可查看全部会话(含完整
# prompt)/删除会话/切换插件——公网或不可信网络必须配置。
# openssl rand -hex 16 生成。
ADMIN_TOKEN=

# ── 存储（PostgreSQL 唯一后端,DATABASE_URL 必填 fail-closed）────
# 四个 Store(会话/任务/插件设置/KG 元数据)+ LangGraph checkpoint 全落 PG。
#
# ⚠ 两种部署形态,只按其一配置 DATABASE_URL:
#   · docker compose 部署:保持注释!compose 会用 POSTGRES_USER/PASSWORD/DB
#     自动拼装(服务名 postgres)。在此显式配置 localhost 地址会覆盖拼装值,
#     容器内指向自身 → 启动崩溃循环。
#   · 裸机/直连部署:取消注释并填真实地址,如:
#     DATABASE_URL=postgresql://llm:密码@localhost:5432/llm_modeler
#
# 存量 SQLite 迁移:停服后跑 backend/scripts/migrate_sqlite_to_pg.py(幂等),
# 源文件落点与执行方式见该脚本头部说明与 README 部署节。
# DATABASE_URL=postgresql://llm:密码@localhost:5432/llm_modeler
# PG 连接池大小(services/db.py;默认 2/8,MIN 不得大于 MAX 否则启动即拒)
# PG_POOL_MIN=2
# PG_POOL_MAX=8
# pytest 专用库(backend/tests/conftest.py 引导;不配则测试收集失败并给指引)。
# 仅本地/CI 使用——生产 .env 不要带此变量(env_file 会注入容器)。
# TEST_DATABASE_URL=postgresql://llm:密码@localhost:5432/llm_modeler_test

# ── CORS(嵌入模式)─────────────────────────────────────────
# 允许跨域访问本服务的宿主来源(逗号分隔);不设 = 允许所有(仅开发期)。
# 生产建议配置宿主域名,防止任意网页直调本服务。
CORS_ALLOWED_ORIGINS=

# ── 请求头透传(嵌入模式 SSO)───────────────────────────────
# 需要透传给上游的请求头前缀(逗号分隔);默认含 x-/authorization/cookie/
# tenant/enterprise/accept-language。
# FORWARD_HEADER_PREFIXES=

# ── 日志 ───────────────────────────────────────────────────
# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_FILE_MAX_BYTES=52428800  # 默认 52428800(50MB)
# LOG_RETENTION=5  # 默认保留 5 份

# =============================================================================
# Docker 部署段(compose 变量;本地裸机开发无需关心)
# =============================================================================

# ── 端口(默认即可,冲突才改)────────────────────────────────
HOST_PORT=19090           # 应用入口(前后端一体,http://IP:19090/ai-modeler/)
NEO4J_BOLT_PORT=7687      # 宿主暴露(调试用;容器间走内网)
NEO4J_HTTP_PORT=17474
MILVUS_PORT=19530
POSTGRES_PORT=15432       # PG 宿主暴露(迁移脚本/调试用;容器间走内网)

# ── PostgreSQL(compose 形态必填;承载会话/链路/任务/设置/KG 元数据)──
POSTGRES_USER=llm
POSTGRES_PASSWORD=        # 必填!未配置时 docker compose up 直接报错
POSTGRES_DB=llm_modeler

# ── 应用容器内存护栏(防 embedding 推理内存失控拖垮整机)────
# 硬上限:超限时该容器被 OOM kill(而非整机卡死);需容纳 ONNX 模型
# (~600MB)+ 并发推理峰值。实测 4g 会被推理峰值撞破(线上两次 OOM kill);
# 8g 可兜住最坏批组合,批 4 段配置下常态峰值 ~2g,余量 4 倍。
APP_MEM_LIMIT=8g
APP_MEM_RESERVATION=1g    # 软预留(docker 调度参考)
