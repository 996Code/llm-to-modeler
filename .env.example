# =============================================================================
# LLM Form Modeler 环境配置示例(复制为 .env 后按部署形态填写)
# 后端:根目录 .env 存在则加载它,否则加载 backend/.env;进程环境变量优先。
# Compose:根目录 .env 用于变量替换,并通过 env_file 注入应用容器。
# LLM 端点、密钥、主备模型在管理端「插件 → 模型供应商」配置,不读环境变量。
# =============================================================================

# ── PostgreSQL(平台存储和 pgvector,必需) ──
# 裸机开发:填写独立运行库,目标 PostgreSQL 必须安装 pgvector。
# Compose:保持 DATABASE_URL 注释,由下方 POSTGRES_* 自动拼接内网连接串。
# 不要给 Compose 填 localhost 地址,容器内 localhost 指向容器自身。
# DATABASE_URL=postgresql://llm:密码@localhost:5432/llm_modeler
# PG_POOL_MIN=2
# PG_POOL_MAX=8
# PG_POOL_TIMEOUT=5             # 连接池取连接超时(秒)
# pytest 使用独立测试库(名称必须含 test),不得与运行库相同;仅本地/CI 配置。
# TEST_DATABASE_URL=postgresql://root:密码@localhost:5432/llm_modeler_test_run

# ── LLM 调用行为(不含供应商端点配置) ──
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=300
# LLM_MAX_RETRIES=2             # SDK 对连接错误/5xx 的重试次数;0=不重试
# LLM_CONTEXT_WINDOW=200000     # 对话压缩的上下文窗口基准(token)
# LLM_RPM_LIMIT=0               # 每分钟请求上限;0=不限
# LLM_TPM_LIMIT=0               # 每分钟 token 上限;0=不限
# LLM_LOG_FULL=1                # 完整 prompt/响应审计;0=仅摘要
# LLM_LOG_PII_REDACT=1           # 审计日志中的敏感字段脱敏
# LLM_CACHE_ENABLED=0           # chat 结果缓存,对话场景默认关闭

# ── 本地向量模型(固定 bge-m3 / 1024 维 / ONNX int8) ──
# deploy.sh 将模型准备到 data/models/embedding/,Compose 挂载后跨版本复用。
# 裸机可指定已有模型目录;未指定时从缓存加载,缓存缺失时下载固定模型。
# EMBEDDING_MODEL_DIR=/绝对路径/bge-m3
# EMBEDDING_CACHE_DIR=~/.cache/llm-embeddings/bge-m3
# EMBEDDING_CPU_THREADS=2
# HF_ENDPOINT=https://hf-mirror.com  # 裸机首次下载源
# EMBED_CACHE_MAX=4096              # embedding/chat 各自缓存条数,TTL 24h
# 向量存储固定 PostgreSQL(pgvector),使用 DATABASE_URL。

# ── 外置重排服务(可选,独立于本地向量模型) ──
# RERANK_BASE_URL=              # Cohere/Jina 兼容 rerank API
# RERANK_MODEL=                 # URL/模型均配置才调用
# RERANK_API_KEY=
# RERANK_TIMEOUT=3              # 超时保留原召回顺序

# ── 上游 HTTP 行为 ──
# 上游地址由宿主 services 表按请求下发,缺少地址时调用报错。
# UPSTREAM_TIMEOUT=30
# UPSTREAM_CACHE_TTL=300        # 秒;0=禁用缓存

# ── 插件 ──
# 部署允许加载的插件上限(逗号分隔);空=不限制。
# 名单外不加载、不显示;名单内管理端可自由启停,状态文件持久化。
PACKS_ENABLED=
# 被启用时加载失败须阻断启动的插件;空=单插件失败独立隔离。
PACKS_CRITICAL=
PACK_STATE_PATH=data/pack_state.json
# PACK_DEPENDENCY_PROBE=1       # 启动/装配时连通性探针;0=只检查配置存在性
# PACK_DEPENDENCY_PROBE_TIMEOUT=3
# TASK_WORKERS=2               # 任务池并发;同 queue_key 始终串行

# ── 知识图谱 ──
# 图数据存于平台 PG(knowledge_graph schema),走 DATABASE_URL,无独立图数据库配置。
# KG_FILES_DIR=data/kg/files
# KG_OCR_ENGINE=rapidocr        # rapidocr/llm;llm 需供应商支持多模态
# 抽取/分段/检索参数在管理端插件设置维护,热生效。

# ── 智能问数 ──
# 数据源密码直接存储供连接使用,管理接口不回显密码。
# SCHEDULER_FAIL_THRESHOLD=5    # 定时任务连续失败停用阈值

# ── 管理访问与嵌入 ──
# 未配置 ADMIN_TOKEN 时开放访问并告警;公网或不可信网络必须配置。
# 配置后 auth.html 口令换 24h Bearer token,亦接受 X-Admin-Token。
# token 签名密钥每次进程启动随机生成,重启后需要重新登录。
ADMIN_TOKEN=
CORS_ALLOWED_ORIGINS=           # 逗号分隔宿主域名;空=允许所有来源
# FORWARD_HEADER_PREFIXES=     # 默认 x-/authorization/cookie/tenant/enterprise/accept-language
# 前端嵌入宿主白名单:VITE_HOST_ORIGINS 在 frontend/.env 或构建进程环境设置。
# 根目录 .env 不参与 Vite 默认加载。

# ── 启动 DDL 重试 ──
# 迁移使用事务级 advisory lock;非法参数启动报错。
# CONV_DDL_RETRY_ATTEMPTS=5
# CONV_DDL_RETRY_BACKOFF_SECONDS=0.5
# PACK_DDL_RETRY_ATTEMPTS=5
# PACK_DDL_RETRY_BACKOFF_SECONDS=3.0

# ── 日志 ──
# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_FILE_MAX_BYTES=52428800
# LOG_RETENTION=5

# =============================================================================
# Compose 部署参数(裸机开发无需配置)
# 当前完整栈含 app / postgres / metrology-mcp。
# =============================================================================
HOST_PORT=19090
# IMAGE_NAME=llm-modeler
POSTGRES_PORT=15432
POSTGRES_USER=llm
POSTGRES_PASSWORD=              # Compose 必填
POSTGRES_DB=llm_modeler
# 内存硬上限需覆盖本地模型和推理峰值;共享宿主机资源由部署方核定。
APP_MEM_LIMIT=8g
APP_MEM_RESERVATION=1g
# APP_CPU_LIMIT=4
# MCP_MEM_LIMIT=128m
# MCP_CPU_LIMIT=0.5

# deploy.sh 进程环境参数(不从 .env 加载):
# GIT_REMOTE=origin
# GIT_BRANCH=main
# HEALTH_TIMEOUT=60
# NODE_IMAGE=node:20-alpine
# PY_IMAGE=python:3.12-slim-trixie
# MIRROR=docker.m.daocloud.io/library
# HF_MIRROR=https://hf-mirror.com
# SKIP_BUILD=0                 # 1=使用已有镜像,同时指定 IMAGE_TAG
# IMAGE_TAG=
# FORCE_DEPLOY=0               # 1=绕过导入队列守卫;部署前先核对任务
# FORCE_DEPS=0
# FORCE_DEBS=0
# FORCE_MODEL=0
