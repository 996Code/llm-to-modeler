  "cards": [
    {
      "dot": "cyan",
      "title": "挂起机制",
      "items": [
        "execute_tool 检测 ask 非空 → interrupt() 抛 PauseSignal，流停止不抛异常",
        "stream.py 主动 get_state 检查 task.interrupts，推 needsClarification 事件",
        "挂起时 HTTP 响应正常结束，等待是新的 HTTP 请求"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复机制",
      "items": [
        "answers 非空 → Command(resume=answers)，不重新分类意图",
        "interrupt() 返回 answer，注入 tool_state.clarify_answers",
        "tool_result=None 触发 route_after_result 回环 rerun 重跑工具"
      ]
    },
    {
      "dot": "rose",
      "title": "一致性防线",
      "items": [
        "thread_id = conversation_id，每过一个节点自动快照",
        "追问作为 assistant 消息落库，防 fan-out 重复只落一次",
        "_awaiting 私有标记区分 answers 归属，防交叉误消费"
      ]
    }
  ]
}
