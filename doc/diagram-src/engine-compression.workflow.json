  "cards": [
    {
      "dot": "cyan",
      "title": "触发与当轮策略",
      "items": [
        "估算口径：CJK 1.5 token/字 + 英文 4 字符/token（compression.py:46-59）",
        "阈值 =（上下文窗口 200K − 预留输出 20K）× 70%",
        "触发后当轮立即降级 keep-recent（最近 3 轮×2 条），不等待压缩完成"
      ]
    },
    {
      "dot": "emerald",
      "title": "旁链设计",
      "items": [
        "单线程 ThreadPoolExecutor 串行化压缩任务，避免并发写冲突",
        "LLM 摘要全量历史而非仅 old 段，防止折叠点丢上下文",
        "summarize_artifact 状态补偿：工具产出先于压缩点折叠"
      ]
    },
    {
      "dot": "rose",
      "title": "两级防御",
      "items": [
        "熔断器：连续 3 次失败熔断 120s，半开自动恢复",
        "PTL 防御：摘要输入超限每次剥最旧 20% 重试，最多 3 次",
        "耗尽后降级截断前 500 字符并写 protection_triggered 标记"
      ]
    }
