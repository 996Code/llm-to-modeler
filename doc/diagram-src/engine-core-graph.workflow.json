      "width": 150
    },
    {
      "id": "stream",
      "lane": "http",
      "col": 1,
      "type": "backend",
      "label": "stream_graph",
      "sublabel": "工作线程 + SSE 队列",
      "width": 140
    },
    {
      "id": "classify",
      "lane": "graph",
