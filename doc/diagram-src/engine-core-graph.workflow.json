      "id": "stream-classify",
      "from": "stream",
      "to": "classify",
      "label": "thread_id = conv_id",
      "variant": "emphasis"
    },
    {
      "id": "classify-confidence",
      "from": "classify",
      "to": "confidence",
      "label": "tool + confidence（无匹配走三级兜底）",
