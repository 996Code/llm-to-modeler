    },
    {
      "id": "confidence-execute",
      "from": "confidence",
      "to": "execute",
      "label": "≥ 0.6 放行",
      "variant": "emphasis"
    },
    {
      "id": "confidence-ask",
      "from": "confidence",
      "to": "ask",
      "label": "低于阈值",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "resume-execute",
      "from": "resume",
      "to": "execute",
      "label": "rerun 重跑",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "execute-result",
      "from": "execute",
      "to": "result",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "图拓扑（graph.py:130-170）",
      "items": [
        "START → classify_intent → check_confidence → execute_tool → handle_result → END",
        "route_by_tool / route_after_result 两条条件边控制流转",
        "handle_result 判 tool_result=None 且有 tool_name 时回环 rerun",
        "一级路由 packs 子集声明（nodes.py:761-790）：声明集过滤未装配后剩 1 个→直通零 LLM；多个→LLM 仅在子集内路由；未声明→全量语义路由——谁发起请求谁声明插件（ChatRequest.packs 与 INIT packs 同义）"
      ]
    },
    {
      "dot": "rose",
      "title": "追问闭环",
      "items": [
        "低置信度或工具 ask 时 interrupt() 挂起，checkpoint 保现场",
        "前端带 answers 重发 → Command(resume) 注入 clarify_answers",
        "rerun 从断点重跑工具，不重新分类意图"
      ]
    },
    {
      "dot": "orange",
      "title": "兜底与降级",
      "items": [
        "无匹配工具走三级兜底：fallback_tool 声明 → fallback pack 首工具 → 全局首个",
        "工具异常分类：ClarificationRaised 转 ask，其余转 error ToolResult",
        "graph 异常 → emit_error + done，SSE 不中断连接"
      ]
    }
  ]
}