  "cards": [
    {
      "dot": "rose",
      "title": "双重门禁（api.py:51-87）",
      "items": [
        "全部管理端点 Depends(admin_required)：token 认证或 X-Admin-Token compare_digest",
        "写操作统一走 _audit 落审计日志",
        "数据源密码 Fernet 加密存储，永不回显"
      ]
    },
    {
      "dot": "cyan",
      "title": "五大分域（api.py + m4.py）",
      "items": [
        "数据源：CRUD / health / scan / refresh-metadata",
        "语义层：GET/PUT + semantic-review + diff + versions + rollback",
        "图谱：graph / subgraph / join-path-preview / communities / hubs / impact",
        "记忆：CRUD + consolidate + backfill；m4：saved-queries + dashboards"
      ]
    },
    {
      "dot": "emerald",
      "title": "一致性语义",
      "items": [
        "语义层 PUT 走 expected_version 乐观锁，冲突 409",
        "versions + rollback 支持任意版本回退",
        "settings 保存后 clear_probe_cache，探针即时生效"
      ]
    }
  ]
