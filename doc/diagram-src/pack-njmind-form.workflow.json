      "label": "生成与校验",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "out",
      "label": "制品产出",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
