{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "njmind_form 插件：表单生成、增量修改与脚本生成",
    "output": "../pack/pack-njmind-form.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "create",
        "label": "生成链",
        "focus": [
          "guide",
          "assets",
          "fields",
          "templates",
          "generate",
          "validate"
        ],
        "note": "从资产列表到配置制品的六步生成。"
      },
      {
        "id": "modify",
        "label": "增量修改",
        "focus": [
          "source",
          "catalog",
          "ops",
          "apply"
        ],
        "note": "两相式增量修改与全量升格。"
      },
      {
        "id": "repair",
        "label": "修复回环",
        "focus": [
          "generate",
          "validate",
          "repair"
        ],
        "note": "本地机械修复与 LLM 重试。"
      },
      {
        "id": "script",
        "label": "脚本生成",
        "focus": [
          "mark",
          "s_catalog",
          "s_locate",
          "s_generate",
          "s_check",
          "s_out"
        ],
        "note": "字段权限 JS 与过滤 SQL：标记分流 + locate→generate→check 三步管线。"
      }
    ]
  },
  "lanes": [
    {
      "id": "create",
      "label": "create_form 六步"
    },
    {
      "id": "modify",
      "label": "modify_form 两相式"
    },
    {
      "id": "policy",
      "label": "修复与升格",
      "variant": "exception"
    },
    {
      "id": "script",
      "label": "脚本工具三步管线"
    }
  ],
  "phases": [
    {
      "id": "collect",
      "label": "资产与字段",
      "fromCol": 0,
      "toCol": 1
