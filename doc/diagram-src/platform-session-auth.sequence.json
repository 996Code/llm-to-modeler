 "cards": [
  {
   "dot": "rose",
   "title": "认证机制（auth.py:76-143）",
   "items": [
    "POST /api/auth/token：ADMIN_TOKEN 换 HMAC-SHA256 签名 token，24h 有效",
    "AuthMiddleware 全局校验；白名单含 /api/health、/api/auth/*",
    "签名密钥进程随机生成，重启自动轮换"
   ]
  },
  {
   "dot": "cyan",
   "title": "多租户三级降级（conversations.py:44）",
   "items": [
    "X-User-Id 头 > userId 参数 > anonymous 兜底",
    "store 层所有读写带 user_id 过滤（服务端强制）",
    "前端 axios 拦截器统一注入，401 跳 auth.html"
   ]
  },
  {
   "dot": "emerald",
   "title": "越权防护",
   "items": [
    "GET /{id}：404 不区分「不存在」与「无权」（fail-closed 不泄露存在性）",
    "chat 历史加载先 conversation_exists 归属校验",
    "admin 端越权访问会话同样被 user_id 拦截"
   ]
  }
 ]
