 "cards": [
  {
   "dot": "cyan",
   "title": "协议钩子（tool.py:206-265）",
   "items": [
    "validate_input → preflight → execute 三段钩子链",
    "format_result / summarize_artifact / title_for 供 SSE、压缩器、会话列表消费",
    "ClarificationRaised 异常由引擎捕获统一转 ToolResult.ask"
   ]
  },
  {
   "dot": "rose",
   "title": "管线恢复语义（tool.py:284-310）",
   "items": [
    "run_pipeline 入口自清 _need_clarify 恢复标记",
    "pipeline_definition 事件先于步骤执行下发前端",
    "_awaiting 私有标记区分 answers 归属，防交叉误消费"
   ]
  },
  {
   "dot": "emerald",
   "title": "artifact 双类型",
   "items": [
    "config 型：存 config_snapshot、驱动「应用」按钮与 diff 对齐",
    "data 型：只存消息、渲染数据卡片（chatbi 图表 / kg 子图）",
    "handle_result 四态分流：error → reply → artifact → 兜底 error"
   ]
  }
 ]
