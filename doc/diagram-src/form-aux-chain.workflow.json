{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "njmind_form 辅助工具链：图片识别、克隆、查询与闲聊",
    "output": "../pack/form-aux-chain.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "image",
        "label": "图片识别链",
        "focus": [
          "img_in",
          "img_analyze",
          "img_gen",
          "img_validate",
          "img_out"
        ],
        "note": "图片接收 → 多模态视觉解析 → 配置生成 → 校验 → 制品返回。"
      },
      {
        "id": "clone",
        "label": "克隆链",
        "focus": [
          "cl_extract",
          "cl_fetch",
          "cl_identity",
          "cl_validate",
          "cl_out"
        ],
        "note": "LLM 提取源标识 → 查源表单 → 改标识 → 校验 → 输出候选不落库。"
      },
      {
        "id": "query",
        "label": "查询链",
        "focus": [
          "get_ctx",
          "get_extract",
          "get_fetch",
          "get_out"
        ],
        "note": "上下文直答优先，无上下文才 LLM 提 formCode 查上游。"
      },
      {
        "id": "chat",
        "label": "闲聊兜底",
        "focus": [
          "chat_prompt",
          "chat_reply",
          "chat_out"
        ],
        "note": "system prompt 三级降级渲染，纯文本回复。"
      }
    ]
  },
