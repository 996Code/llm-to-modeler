    },
    {
      "id": "prepare-commit",
      "from": "prepare",
      "to": "commit",
      "label": "校验通过",
      "variant": "emphasis"
    },
    {
      "id": "commit-finalize",
      "from": "commit",
      "to": "finalize",
      "label": "persist 成功",
      "variant": "emphasis"
    },
    {
      "id": "prepare-rollback",
      "from": "prepare",
      "to": "rollback",
      "label": "Prepare/Commit 失败",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "rollback-degraded",
      "from": "rollback",
      "to": "degraded",
      "label": "回滚失败",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "finalize-degraded",
      "from": "finalize",
      "to": "degraded",
      "label": "finalize 失败保持新态",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "assemble-prepare",
      "from": "assemble",
      "to": "prepare",
      "label": "进入事务",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "启动顺序（main.py:96-212）",
      "items": [
        "PG 必填 fail-closed，缺库直接拒绝启动",
        "TaskManager.recover_on_startup 把遗留任务标 interrupted",
        "PackState 优先级：状态文件 > PACKS_ENABLED env > 全发现"
      ]
    },
    {
      "dot": "emerald",
      "title": "装配三段事务（pack_manager.py:76）",
      "items": [
        "Prepare：staging handlers + 临时 FastAPI 展开路由 + runtime_contract 校验",
        "Commit：nodes.configure + app.state 引用替换 + commit_routes",
        "Finalize：start/unload 钩子，仅 persist 成功后执行"
      ]
    },
    {
      "dot": "rose",
      "title": "失败语义",
      "items": [
        "Prepare/Commit 失败 → 快照回滚；回滚也失败 → AssemblyRollbackFailedError",
        "PERSISTED 后 finalize 失败：保持新态 + degraded，不与磁盘分裂",
        "degraded 后中间件对非 /health 请求 503，管理操作被拒"
      ]
    }
  ]
}