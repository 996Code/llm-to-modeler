  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "采集埋点",
      "items": [
        "LLMClient._log_call 与 UpstreamClient._log 双出口埋点",
        "conv_id 缺省时从线程绑定上下文兜底，链路不断",
        "LLM_LOG_FULL 开关：完整 prompt（图片转占位符）或摘要"
      ]
    },
    {
      "dot": "emerald",
      "title": "链路视图",
      "items": [
        "事件流 + 调用日志按时间轴合并，assistant 闭轮分段",
        "汇总 llm / upstream / graph / vector 次数与耗时",
        "用户侧与管理端复用同一 _build_trace 实现"
      ]
    },
    {
      "dot": "rose",
      "title": "脱敏防线",
      "items": [
        "RedactFilter 六条正则：Bearer / sk- / Authorization / Cookie / x-api-key / JWT",
        "改写 msg 并清空 args，防止格式化参数泄漏",
        "挂 root logger，所有模块输出统一过滤"
      ]
    }
  ]
}