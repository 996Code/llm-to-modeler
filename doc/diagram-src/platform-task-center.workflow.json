  "cards": [
    {
      "dot": "cyan",
      "title": "提交与调度（task_manager.py:241-313）",
      "items": [
        "dedupe_key 检查+占位同一临界区——拆两段会 TOCTOU 双双落库（二次走查抓出的竞态）",
        "queue_key 串行：同 key FIFO 串行（如同库导入不并发写图），无 key 互不阻塞",
        "派发条件 = 串行键未占用 且 并发未满（TASK_WORKERS 默认 2）"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行与收尾（task_manager.py:315-383）",
      "items": [
        "_run 全程 try/finally：store 异常也必须释放串行键，否则该键后续任务永久 pending",
        "TaskHandle.set_progress/log 持久化 + SSE 双路（task_manager.py:58-79）",
        "终态监听者回调供 pack 释放提交期登记的资源（pending 期取消 finally 不生效，只能靠这里兜底）"
      ]
    },
    {
      "dot": "rose",
      "title": "取消与自动续跑（task_manager.py:387-570）",
      "items": [
        "cancel：pending 直接落 cancelled；running 置标志等 handler 到检查点自杀；retry_scheduled 取消 = 撤销续跑计划",
        "续跑 5 分钟固定退避；retry_count 继承封顶——否则恒定失败任务无限空转（线上实证 3 小时 10+ 轮）",
        "永久性错误（PermanentTaskError）/致命 LLM 错误（欠费/鉴权）不重试"
      ]
    },
    {
      "dot": "violet",
      "title": "SSE 可观测与启动恢复（api/tasks.py:95-155 / task_store.py:263-285）",
      "items": [
        "GET /api/tasks/{id}/events：snapshot → progress/log/status + keepalive 保活",
        "subscribe 先注册监听再拍快照保证不丢事件；满队丢帧按日志 id 游标补齐",
        "recover_on_startup：遗留 pending/running 标 interrupted，不自动续跑，由 pack 幂等重跑承接",
        "HTTP API 全集：列表 / 详情 / 日志回放 / 取消 / 类型清单（api/tasks.py:40-96）"
      ]
    }
  ]
}