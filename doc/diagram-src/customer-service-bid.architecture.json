  "cards": [
    {
      "dot": "cyan",
      "title": "业界参考（本次检索）",
      "items": [
        "分层参考 IBM 会话式 AI 与 Microsoft Bot Framework：渠道接入、NLU 意图/实体、对话管理、回答生成、人工交接。",
        "知识链路参考 AWS / Microsoft RAG：知识摄取向量化 → 混合检索 → 证据增强 → 生成带引用。",
        "人工兜底为业界标配；本平台当前实现为无据不答并提示人工确认。"
      ]
    },
    {
      "dot": "emerald",
      "title": "本平台落地",
      "items": [
        "引擎层：LLM 意图路由 + 槽位提取 + LangGraph 编排，多轮追问与断点恢复。",
        "知识层：图谱 / 向量 / 全文混合检索，回答带结论校验与引用编号；知识运营含导入、标注、权限。",
        "集成层：固定 MCP 工具受控调用业务系统返回结构化结果；模型统一网关支持主备与限速。",
        "智能问数（Text-to-SQL）：Schema 检索生成 SQL，经 AST 只读、危险函数、列白名单三层校验，仅以只读账号在白名单库表执行。"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与承诺",
      "items": [
        "平台部署于采购人内网；出网点仅模型 API（境内供应商）与业务系统 MCP 通道。",
        "客服业务查询走固定 MCP 工具；智能问数为独立通道，SQL 只读执行且与客服受控路径隔离，不开放业务库直连。",
        "不承诺自动转坐席工单、附件组合报价、MCP 自动重试或全失败纯检索降级。"
      ]
    }
  ]
