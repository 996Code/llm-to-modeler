# llm-to-modler — 部署环境变量配置
# 使用方式:cp deploy.env.example .env,填入真实值后 ./deploy.sh

# ===== LLM(必填;OpenAI 兼容接口,dashscope/oneapi/vllm 均可)=====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max
LLM_MAX_TOKENS=200000
LLM_TIMEOUT=300
# 向量模型(知识图谱插件的向量检索用;不配则纯图谱模式)
LLM_EMBED_MODEL=text-embedding-v3
# 向量化后端:api(云端,默认) / local(进程内 ONNX,bge-m3)
# local 零 API 费用;与云端同为 1024 维,无需重建 Milvus collection
# 首次部署时 deploy.sh 自动下载模型到 deploy/models/embedding/(~543MB)
EMBEDDING_BACKEND=api

# ===== 管理端访问口令(生产必填;不配则管理端开放访问)=====
# openssl rand -hex 16 生成;管理页/admin.html 登录框输入此 token
ADMIN_TOKEN=

# ===== Neo4j(必填密码;compose 内自动组网,只需设密码)=====
NEO4J_PASSWORD=change-me-in-production

# ===== 端口(默认即可,冲突才改)=====
HOST_PORT=19090         # 应用入口(前后端一体,http://IP:19090/ai-modeler/)
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=17474
MILVUS_PORT=19530

# ===== 限速(可选;撞服务商限额时配,0=不限)=====
LLM_RPM_LIMIT=0
LLM_TPM_LIMIT=0
